# Copy to .env. Never commit real credentials.
APP_ORIGIN=http://127.0.0.1:5173
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: npm run setup:local
SESSION_SECRET=

# Optional activity counters. Set these for Production only in Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
